# Password of the web UI, typed on /login (session cookie valid 30 days). Required in production.
# Changing it logs out every browser.
ATOOLS_PASSWORD=change-me
# Key for API clients (e.g. the Switch homebrew): "Authorization: Bearer <key>" or "X-API-Key: <key>".
ATOOLS_API_KEY=change-me-too
# Where apps store their files (default: ./data). The Docker image uses /app/data.
# ATOOLS_DATA_DIR=/app/data
